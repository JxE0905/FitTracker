<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="15dp"
    android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/txtTipo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fuerza"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtIntensidad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Intensidad: Alta"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/txtAspectos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Completado: Calentamiento"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtProgreso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Progreso: 50%"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtEsfuerzo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Esfuerzo: 3 estrellas"
        android:textSize="14sp" />

</LinearLayout>