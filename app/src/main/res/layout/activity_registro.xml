<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registro de entrenamiento"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo de entrenamiento"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerEntrenamiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Intensidad"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioGroupIntensidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <RadioButton
                android:id="@+id/radioBaja"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Baja" />

            <RadioButton
                android:id="@+id/radioMedia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Media" />

            <RadioButton
                android:id="@+id/radioAlta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alta" />

        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aspectos completados"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/checkCalentamiento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calentamiento realizado" />

        <CheckBox
            android:id="@+id/checkHidratacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hidratación adecuada" />

        <CheckBox
            android:id="@+id/checkEstiramiento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estiramiento final"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Progreso diario"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtProgresoValor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Progreso: 50%"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50" />

        <SeekBar
            android:id="@+id/seekBarProgreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Esfuerzo percibido"
            android:textStyle="bold" />

        <RatingBar
            android:id="@+id/ratingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="1"
            android:rating="3"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnRegistrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="REGISTRAR ACTIVIDAD"
            android:layout_marginBottom="25dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sesiones registradas"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSesiones"
            android:layout_width="match_parent"
            android:layout_height="300dp" />

    </LinearLayout>

</ScrollView>